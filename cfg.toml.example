# Copy to cfg.toml and fill in. cfg.toml is git-ignored.
#
#   cp cfg.toml.example cfg.toml
#
# Read by two different things, and the difference matters:
#
#   ./dev/provision.sh    writes these values into a board's flash, once.
#                         This is how a unit is configured.
#
#   build.rs              reads `ap_secret` ONLY. No credential below this
#                         line is compiled into the firmware.
#
# A board with no record raises its own Wi-Fi network and asks to be set up; it
# does not fall back to anything. Changing a credential here means re-running
# ./dev/provision.sh, not a rebuild.

wifi_ssid     = "your-wifi"
wifi_password = "your-wifi-password"

# The broker, as an IP address. Not a hostname: `mqtt.rs` parses this with
# `Ipv4Addr::from_str` and there is no resolver on the device, so a name would
# be stored, survive the reboot, and leave the unit retrying forever.
#
# `auto` means "this machine's LAN address", worked out by ./dev/provision.sh
# when it builds the record. That is almost always what you want for the local
# dev stack, because the Mac's address comes from DHCP and moves — and when it
# moves, every unit provisioned before it keeps the old one and sits flashing
# red twice. That is correct behaviour for "no broker" and indistinguishable
# from a broker that is actually down.
#
# Override per unit without editing this file:
#
#   ./dev/provision.sh --host 192.168.68.126    # the Pi, for a real install
#
# For production, give the broker's machine a DHCP reservation and write that
# address here. `auto` is a development convenience, not a fix for an address
# that ought to be stable.
mqtt_host     = "auto"
mqtt_port     = 1883
mqtt_user     = "feeder"
mqtt_password = "feeder-dev"

# Salt for the setup network's password. Generate once and keep it:
#
#   openssl rand -hex 16
#
# Each unit's setup password is base32(sha256("<ap_secret>:<device id>")), so it
# is different per unit and cannot be worked out from the MAC the unit
# broadcasts in its SSID and beacons. Without the salt it would be public, and
# WPA2 gives no protection against someone who knows the passphrase — they could
# read the setup session, which is the one where the Wi-Fi password above gets
# typed in.
#
# `./dev/ap-password.sh <device id>` prints it, for stickers.
#
# Changing it invalidates every sticker already printed. It is not a secret that
# protects your network; it only protects the setup window.
ap_secret     = "change-me"

# ---------------------------------------------------------------------------
# Per-unit mechanics. Used only by ./dev/provision.sh, never compiled.
# ---------------------------------------------------------------------------
#
# These are defaults. The three feeders are not all the same model, so measure
# each one and override it on the command line rather than editing this file:
#
#   ./dev/provision.sh --detent-ms 900 --portion-scale 133
#
# detent_ms: milliseconds from one switch click to the next, under power. Read
# it off the console timestamps during a four-portion feed. The minimum click
# spacing and the jam timeout are both derived from it, so it is the one
# mechanical figure worth measuring carefully.
detent_ms = 1900

# portion_scale_pct: how much this unit dispenses per click, relative to a
# notional standard portion. 100 changes nothing; 133 means three portions
# become four clicks. feeder/schedule is shared by all three units, so this is
# what stops one of them quietly over- or under-feeding.
portion_scale_pct = 100
