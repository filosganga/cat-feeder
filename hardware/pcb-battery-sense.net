(export (version "E")
  (design (source "dev/netlist.toml, by hand, plus the battery sense of docs/roadmap.md") (tool "hand-written"))
  (components
    (comp (ref "U1") (value "ESP32-C6-Zero") (footprint "ESP32-C6-Zero"))
    (comp (ref "U2") (value "DRV8833 breakout") (footprint "DRV8833-breakout"))
    (comp (ref "U3") (value "DS3231 module") (footprint "DS3231-module"))
    (comp (ref "J1") (value "feeder cable") (footprint "PinHeader_1x06_P2.54mm_Vertical"))
    (comp (ref "J2") (value "Zero back pads") (footprint "PinHeader_1x02_P2.54mm_Vertical"))
    (comp (ref "J3") (value "LED and BOOT") (footprint "PinHeader_1x04_P2.54mm_Vertical"))
    (comp (ref "D1") (value "MBRF2045CT") (footprint "TO-220-3_Vertical"))
    (comp (ref "C1") (value "220uF 16V") (footprint "CP_Radial_D6.3mm_P5.08mm"))
    (comp (ref "R1") (value "1k") (footprint "R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref "R2") (value "1k") (footprint "R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "R3") (value "1k") (footprint "R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "R4") (value "20k") (footprint "R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref "R5") (value "10k") (footprint "R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref "R6") (value "200k") (footprint "R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref "R7") (value "100k") (footprint "R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm_Horizontal"))
    (comp (ref "C2") (value "100nF") (footprint "C_Disc_D5.0mm_W2.5mm_P5.00mm"))
  )
  (nets
    (net (code "1") (name "5v") (node (ref "C1") (pin "1")) (node (ref "D1") (pin "2")) (node (ref "U1") (pin "5V")) (node (ref "U2") (pin "VCC")) (node (ref "J3") (pin "2")))
    (net (code "2") (name "gnd") (node (ref "C1") (pin "2")) (node (ref "J1") (pin "1")) (node (ref "U1") (pin "GND")) (node (ref "U2") (pin "GND")) (node (ref "U3") (pin "GND")) (node (ref "J3") (pin "1")) (node (ref "R5") (pin "2")) (node (ref "R7") (pin "2")) (node (ref "C2") (pin "2")))
    (net (code "3") (name "3v3") (node (ref "U1") (pin "3V3")) (node (ref "U3") (pin "VCC")))
    (net (code "4") (name "usb_in") (node (ref "J1") (pin "2")) (node (ref "D1") (pin "1")) (node (ref "R4") (pin "1")))
    (net (code "5") (name "battery_in") (node (ref "J1") (pin "3")) (node (ref "D1") (pin "3")) (node (ref "R6") (pin "1")))
    (net (code "6") (name "usb_sense") (node (ref "R4") (pin "2")) (node (ref "R5") (pin "1")) (node (ref "U1") (pin "GP3")))
    (net (code "7") (name "battery_sense") (node (ref "R6") (pin "2")) (node (ref "R7") (pin "1")) (node (ref "C2") (pin "1")) (node (ref "U1") (pin "GP4")))
    (net (code "8") (name "motor_in1") (node (ref "U1") (pin "GP0")) (node (ref "U2") (pin "IN1")))
    (net (code "9") (name "motor_in2") (node (ref "U1") (pin "GP1")) (node (ref "U2") (pin "IN2")))
    (net (code "10") (name "motor_sleep") (node (ref "U1") (pin "GP14")) (node (ref "U2") (pin "ULT")))
    (net (code "11") (name "motor_1") (node (ref "U2") (pin "OUT1")) (node (ref "J1") (pin "4")))
    (net (code "12") (name "motor_2") (node (ref "U2") (pin "OUT2")) (node (ref "J1") (pin "5")))
    (net (code "13") (name "switch") (node (ref "U1") (pin "GP2")) (node (ref "R1") (pin "2")))
    (net (code "14") (name "switch_cable") (node (ref "J1") (pin "6")) (node (ref "R1") (pin "1")))
    (net (code "15") (name "i2c_sda") (node (ref "U1") (pin "GP18")) (node (ref "U3") (pin "SDA")))
    (net (code "16") (name "i2c_scl") (node (ref "U1") (pin "GP19")) (node (ref "U3") (pin "SCL")))
    (net (code "17") (name "led") (node (ref "J2") (pin "1")) (node (ref "R2") (pin "1")))
    (net (code "18") (name "led_cable") (node (ref "R2") (pin "2")) (node (ref "J3") (pin "3")))
    (net (code "19") (name "boot") (node (ref "J2") (pin "2")) (node (ref "R3") (pin "1")))
    (net (code "20") (name "boot_cable") (node (ref "R3") (pin "2")) (node (ref "J3") (pin "4")))
  )
)
